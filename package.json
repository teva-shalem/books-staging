{
  "name": "tevadynamica",
  "description": "מערכת יחסים מופלאה, יחידה וקדושה, של הקליפות עם הלב. של האור ההולך וחוזר",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vuepress dev books --no-clear-screen",
    "lint": "eslint --ext .js,.ts,.vue .",
    "generate-pdfs": "node scripts/generate-pdfs.js",
    "zip-offline": "node scripts/zip-offline.js",
    "prebuild": "npm run lint",
    "build": "vuepress build books",
    "serve": "npx serve dist",
    "deploy:stage": "git push -f stage master",
    "deploy:world": "git push -f world master && git push -f forever master",
    "upgrade": "npx npm-check-updates@16 --interactive"
  },
  "dependencies": {
    "buefy": "^0.9.23",
    "katex": "^0.19.1",
    "mathjax": "^4.1.3",
    "v-tooltip": "^2.1.3",
    "vue": "^2.7.16",
    "vue-katex": "^0.5.0",
    "vue-server-renderer": "^2.7.16",
    "vuepress-theme-derech-hapeima": "file:books/.vuepress/theme"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vuepress/plugin-back-to-top": "^1.9.10",
    "@vuepress/plugin-google-analytics": "^1.9.10",
    "@vuepress/plugin-medium-zoom": "^1.9.10",
    "@vuepress/plugin-pwa": "^1.9.10",
    "adm-zip": "^0.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "markdown-it-attrs": "^4.1.6",
    "puppeteer": "^21.5.0",
    "sass": "~1.77.8",
    "sass-loader": "^10.5.2",
    "serve-handler": "^6.1.8",
    "ts-loader": "^8.2.0",
    "typescript": "5.4",
    "vue-eslint-parser": "^9.4.3",
    "vuepress": "^1.9.10",
    "vuepress-plugin-table-of-contents": "^1.1.7",
    "vuepress-plugin-typescript": "^0.3.1",
    "vuepress-types": "^0.9.4"
  },
  "overrides": {
    "vuepress-plugin-typescript": {
      "ts-loader": "^8.2.0"
    },
    "minimatch": "9.0.5",
    "node-releases": "2.0.18"
  },
  "engines": {
    "node": "<=16.x"
  }
}
