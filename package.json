{
  "name": "tevadynamica",
  "description": "מערכת יחסים מופלאה, יחידה וקדושה, של הקליפות עם הלב. של האור ההולך וחוזר",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "vuepress dev books --no-clear-screen",
    "generate-pdfs": "node scripts/generate-pdfs.js",
    "zip-offline": "node scripts/zip-offline.js",
    "lint:code": "eslint --ext .js,.cjs,.ts,.vue .",
    "lint:style": "stylelint \"books/.vuepress/**/*.{vue,scss}\"",
    "lint:style:watch": "chokidar \".stylelintrc.json\" \"books/.vuepress/**/*.{vue,scss}\" --initial -c \"node scripts/watch-stylelint.js\"",
    "lint": "npm run lint:style && npm run lint:code",
    "build": "vuepress build books",
    "postbuild": "npm run generate-pdfs",
    "serve": "serve dist",
    "deploy:stage": "git push -f stage master",
    "deploy:world": "git push -f world master && git push -f forever master",
    "upgrade": "npx npm-check-updates@16 --interactive"
  },
  "dependencies": {
    "buefy": "^0.9.29",
    "katex": "^0.19.1",
    "v-tooltip": "^2.1.3",
    "vue": "^2.7.16",
    "vue-katex": "^0.5.0",
    "vue-server-renderer": "^2.7.16",
    "vuepress-theme-derech-hapeima": "file:books/.vuepress/theme"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vuepress/plugin-back-to-top": "^1.9.10",
    "@vuepress/plugin-google-analytics": "^1.9.10",
    "@vuepress/plugin-medium-zoom": "^1.9.10",
    "@vuepress/plugin-pwa": "^1.9.10",
    "adm-zip": "^0.6.1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.3",
    "markdown-it-attrs": "^5.0.1",
    "postcss-html": "^1.8.1",
    "puppeteer": "^21.11.0",
    "sass": "~1.79.6",
    "sass-loader": "^10.5.2",
    "serve": "^14.2.8",
    "serve-handler": "^6.1.8",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "ts-loader": "^8.4.0",
    "typescript": "~5.5.4",
    "vue-eslint-parser": "^9.4.3",
    "vuepress": "^1.9.10",
    "vuepress-plugin-table-of-contents": "^1.1.7",
    "vuepress-plugin-typescript": "^0.3.1",
    "vuepress-types": "^0.9.4"
  },
  "overrides": {
    "vuepress-plugin-typescript": {
      "ts-loader": "^8.4.0"
    },
    "minimatch": "9.0.5",
    "node-releases": "2.0.18"
  },
  "engines": {
    "node": "<=16.x"
  }
}
